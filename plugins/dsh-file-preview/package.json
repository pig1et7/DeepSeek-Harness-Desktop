{
  "name": "dsh-file-preview",
  "description": "Sidebar file preview + diff panel for the DeepSeek Harness Web GUI: browse files the agent wrote/edited, preview their content, and review the diffs.",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "fflate": "^0.8.2"
  },
  "optionalDependencies": {
    "pdfjs-dist": "^4.10.38"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  }
}